# ── AI Provider ──────────────────────────────────────────────────────────────
# Choose "claude" (paid, best accuracy) or "gemini" (free tier available)
AI_PROVIDER=gemini

# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini — https://aistudio.google.com/app/apikey  (free, no credit card needed)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash   # default; use gemini-1.5-pro for better accuracy

# ── Optional integrations ─────────────────────────────────────────────────────
# The Blue Alliance API — auto-fills alliance data from match keys
# Get one at: https://www.thebluealliance.com/account
TBA_API_KEY=your_tba_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
